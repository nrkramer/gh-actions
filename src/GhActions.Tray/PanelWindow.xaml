<Window x:Class="GhActions.Tray.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Actions" Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        MaxHeight="720" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Border Background="{StaticResource Bg}" CornerRadius="10"
          BorderBrush="{StaticResource BgRaised}" BorderThickness="1" Padding="0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="#000000" />
    </Border.Effect>

    <DockPanel LastChildFill="True">

      <!-- header -->
      <Grid DockPanel.Dock="Top" Margin="14,12,10,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="GitHub Actions" FontWeight="SemiBold" FontSize="13"
                   Foreground="{StaticResource Purple}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" x:Name="Stamp" Style="{StaticResource Subtle}" Margin="0,0,8,0" />
        <Button Grid.Column="2" x:Name="RefreshButton" Style="{StaticResource Flat}"
                Padding="8,3" Click="OnRefresh" ToolTip="Refresh now">
          <TextBlock Text="↻" FontSize="14" Foreground="{StaticResource Blue}" />
        </Button>
      </Grid>

      <TextBlock x:Name="EmptyLabel" DockPanel.Dock="Top" Text="No data yet."
                 Style="{StaticResource Subtle}" HorizontalAlignment="Center"
                 Margin="0,16,0,18" Visibility="Collapsed" />

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Padding="0,0,0,8">
        <ItemsControl x:Name="RepoList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Separator Background="#232433" Margin="10,2,10,0" Height="1" />

                <!-- repo header -->
                <Grid Margin="12,9,12,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding Dot}"
                           VerticalAlignment="Center" Margin="0,0,9,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                             FontSize="12.5" Foreground="{StaticResource Fg}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Error}" Style="{StaticResource Subtle}"
                             Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <TextBlock Text="no runs" Style="{StaticResource Subtle}" Margin="34,0,0,6"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <!-- runs -->
                <ItemsControl ItemsSource="{Binding Runs}" Margin="24,0,10,4">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,4">

                        <ToggleButton x:Name="Head" Style="{StaticResource Flat}" Padding="4,3"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Width="14" FontSize="10"
                                       Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                                       Text="{Binding IsChecked, ElementName=Head,
                                              Converter={StaticResource BoolToArrow}}" />
                            <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding Dot}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12"
                                       Foreground="{StaticResource Fg}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="3" Text="{Binding Meta}"
                                       Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </ToggleButton>

                        <!-- job groups -->
                        <ItemsControl ItemsSource="{Binding Groups}" Margin="14,2,0,0"
                                      Visibility="{Binding IsChecked, ElementName=Head,
                                                   Converter={StaticResource BoolToVis}}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel>
                                <TextBlock Text="{Binding Platform}" Margin="8,4,0,1"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Blue}"
                                           Visibility="{Binding HasPlatform,
                                                        Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Jobs}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Button Style="{StaticResource Flat}" Padding="8,3"
                                              Click="OnJobClick" Tag="{Binding Url}"
                                              ToolTip="{Binding Tooltip}">
                                        <Grid>
                                          <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                          </Grid.ColumnDefinitions>
                                          <Ellipse Grid.Column="0" Width="8" Height="8"
                                                   Fill="{Binding Dot}" VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                          <TextBlock Grid.Column="1" Text="{Binding Short}"
                                                     FontSize="11.5" Foreground="{StaticResource Fg}"
                                                     TextTrimming="CharacterEllipsis"
                                                     VerticalAlignment="Center" />
                                          <TextBlock Grid.Column="2" Text="{Binding Age}"
                                                     Style="{StaticResource Subtle}" Margin="8,0,0,0" />
                                        </Grid>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
