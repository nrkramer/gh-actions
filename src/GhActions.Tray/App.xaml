<Application x:Class="GhActions.Tray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GhActions.Tray"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <local:BoolToVisibility x:Key="BoolToVis" />
    <local:BoolToArrow x:Key="BoolToArrow" />

    <SolidColorBrush x:Key="Bg"       Color="#1a1b26" />
    <SolidColorBrush x:Key="BgRaised" Color="#292e42" />
    <SolidColorBrush x:Key="Fg"       Color="#c0caf5" />
    <SolidColorBrush x:Key="Dim"      Color="#565f89" />
    <SolidColorBrush x:Key="Blue"     Color="#7aa2f7" />
    <SolidColorBrush x:Key="Purple"   Color="#bb9af7" />

    <Style x:Key="Subtle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Dim}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Flat, chromeless buttons: WPF's default chrome is grey and utterly
         wrong against this palette, so every button is retemplated. -->
    <Style x:Key="Flat" TargetType="ButtonBase">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#292e42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
